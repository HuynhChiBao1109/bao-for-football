{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug service-core",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/service-core/cmd/server",
      "cwd": "${workspaceFolder}/apps/service-core",
      "env": {
        "GO111MODULE": "on"
      }
    }, 
    {
      "name": "Debug =migrate",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/database/migrate.go",
      "cwd": "${workspaceFolder}/database",
      "env": {
        "GO111MODULE": "on"
      }
    }, 
  ]
}